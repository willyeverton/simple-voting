<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.0/phpunit.xsd"
         bootstrap="web/core/tests/bootstrap.php"
         cacheDirectory=".phpunit.drupal.cache"
         colors="true">
  <testsuites>
    <testsuite name="Simple Voting Drupal">
      <directory suffix="Test.php">web/modules/custom/simple_voting/tests/src/Kernel</directory>
      <directory suffix="Test.php">web/modules/custom/simple_voting/tests/src/Functional</directory>
    </testsuite>
  </testsuites>
</phpunit>
