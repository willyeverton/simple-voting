{
  "info": {
    "name": "Simple Voting API",
    "description": "Collection inicial alinhada a docs/openapi.yaml. Requer uma instalação Drupal e autenticação em todos os endpoints; o usuário precisa das permissões específicas para votar e consultar resultados ocultos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://simple-voting.lndo.site"
    },
    {
      "key": "question_id",
      "value": "pergunta_exemplo"
    },
    {
      "key": "option_id",
      "value": "1"
    },
    {
      "key": "csrf_token",
      "value": ""
    }
  ],
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "admin",
        "type": "string"
      },
      {
        "key": "password",
        "value": "",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "List questions",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response contains data array', function () { pm.expect(pm.response.json().data).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/questions",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "questions"]
        }
      }
    },
    {
      "name": "Get question",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Question contains options', function () { pm.expect(pm.response.json().data.options).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/questions/{{question_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "questions", "{{question_id}}"]
        }
      }
    },
    {
      "name": "Create vote",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response contains message', function () { pm.expect(pm.response.json().message).to.be.a('string'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}",
            "disabled": true
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"option_id\": {{option_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/questions/{{question_id}}/votes",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "questions", "{{question_id}}", "votes"]
        }
      }
    },
    {
      "name": "Get results",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Results contain totals', function () { pm.expect(pm.response.json().data.total_votes).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/questions/{{question_id}}/results",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "questions", "{{question_id}}", "results"]
        }
      }
    }
  ]
}
