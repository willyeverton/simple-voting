<?php

/**
 * @file
 * Install, schema, and uninstall hooks for Simple Voting.
 */

/**
 * Implements hook_schema().
 */
function simple_voting_schema(): array {
  $schema['simple_voting_option'] = [
    'description' => 'Options belonging to a Simple Voting question.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'question_id' => [
        'type' => 'varchar',
        'length' => 128,
        'charset' => 'ascii',
        'not null' => TRUE,
      ],
      'title' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'description' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
      ],
      'image_fid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ],
      'weight' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'question_weight' => ['question_id', 'weight'],
      'question_id' => ['question_id'],
    ],
  ];

  $schema['simple_voting_vote'] = [
    'description' => 'Immutable user votes for Simple Voting questions.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'question_id' => [
        'type' => 'varchar',
        'length' => 128,
        'charset' => 'ascii',
        'not null' => TRUE,
      ],
      'option_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'question_uid' => ['question_id', 'uid'],
    ],
    'indexes' => [
      'question_option' => ['question_id', 'option_id'],
      'uid' => ['uid'],
      'question_id' => ['question_id'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function simple_voting_install(): void {
  simple_voting_set_default_theme();
  simple_voting_ensure_theme_blocks();
}

/**
 * Sets the frontend default theme.
 *
 * The administrative theme is not changed.
 */
function simple_voting_set_default_theme(): void {
  $theme_handler = \Drupal::service('theme_handler');
  if (!$theme_handler->themeExists('simple_voting_theme')) {
    \Drupal::service('theme_installer')->install(['simple_voting_theme']);
  }

  $theme_config = \Drupal::configFactory()->getEditable('system.theme');
  $current_default = (string) $theme_config->get('default');
  if ($current_default !== 'simple_voting_theme') {
    $state = \Drupal::state();
    if ($state->get('simple_voting.previous_default_theme') === NULL) {
      $state->set('simple_voting.previous_default_theme', $current_default);
    }
    $theme_config->set('default', 'simple_voting_theme')->save();
  }
}

/**
 * Restores the frontend theme that was active before Simple Voting.
 */
function simple_voting_restore_previous_theme(): void {
  $state = \Drupal::state();
  $previous = $state->get('simple_voting.previous_default_theme');
  $theme_handler = \Drupal::service('theme_handler');
  $theme_config = \Drupal::configFactory()->getEditable('system.theme');

  if (is_string($previous)
    && $previous !== ''
    && $theme_config->get('default') === 'simple_voting_theme'
    && $theme_handler->themeExists($previous)) {
    $theme_config->set('default', $previous)->save();
  }

  $state->delete('simple_voting.previous_default_theme');
}

/**
 * Ensures the global theme's default blocks exist.
 */
function simple_voting_ensure_theme_blocks(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $blocks = [
    'simple_voting_theme_main_menu' => [
      'plugin' => 'system_menu_block:main',
      'region' => 'primary_menu',
      'settings' => [
        'id' => 'system_menu_block:main',
        'label' => 'Main navigation',
        'label_display' => '0',
        'provider' => 'system',
        'level' => 1,
        'depth' => 2,
        'expand_all_items' => TRUE,
      ],
    ],
    'simple_voting_theme_account_menu' => [
      'plugin' => 'system_menu_block:account',
      'region' => 'account_menu',
      'settings' => [
        'id' => 'system_menu_block:account',
        'label' => 'User account menu',
        'label_display' => '0',
        'provider' => 'system',
        'level' => 1,
        'depth' => 1,
        'expand_all_items' => FALSE,
      ],
    ],
    'simple_voting_theme_messages' => [
      'plugin' => 'system_messages_block',
      'region' => 'messages',
      'settings' => [
        'id' => 'system_messages_block',
        'label' => 'Status messages',
        'label_display' => '0',
        'provider' => 'system',
      ],
    ],
    'simple_voting_theme_page_title' => [
      'plugin' => 'page_title_block',
      'region' => 'content',
      'settings' => [
        'id' => 'page_title_block',
        'label' => 'Page title',
        'label_display' => '0',
        'provider' => 'core',
      ],
    ],
  ];

  foreach ($blocks as $id => $block) {
    if ($storage->load($id)) {
      continue;
    }
    $storage->create([
      'id' => $id,
      'theme' => 'simple_voting_theme',
      'status' => TRUE,
      'region' => $block['region'],
      'weight' => 0,
      'provider' => NULL,
      'plugin' => $block['plugin'],
      'settings' => $block['settings'],
      'visibility' => [],
    ])->save();
  }
}

/**
 * Adds the global voting switch for installations created before it existed.
 */
function simple_voting_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('simple_voting.settings');
  if ($config->get('voting_enabled') === NULL) {
    $config->set('voting_enabled', TRUE)->save();
  }
}

/**
 * Marks the voting question entity definition as installed.
 */
function simple_voting_update_11002(): void {
  // Entity definition changes are detected and recorded by Drupal's update
  // system when this update is applied.
}

/**
 * Installs the voting question entity definition for existing sites.
 */
function simple_voting_update_11003(): void {
  $entity_type = \Drupal::entityTypeManager()->getDefinition('voting_question');
  \Drupal::entityDefinitionUpdateManager()->installEntityType($entity_type);
}

/**
 * Installs the global Simple Voting frontend theme for existing sites.
 */
function simple_voting_update_11004(): void {
  simple_voting_set_default_theme();
}

/**
 * Installs missing default blocks for the global frontend theme.
 */
function simple_voting_update_11005(): void {
  simple_voting_set_default_theme();
  simple_voting_ensure_theme_blocks();
}

/**
 * Reconciles the global frontend theme blocks after configuration restoration.
 */
function simple_voting_update_11006(): void {
  simple_voting_set_default_theme();
  simple_voting_ensure_theme_blocks();
}

/**
 * Implements hook_uninstall().
 */
function simple_voting_uninstall(): void {
  simple_voting_restore_previous_theme();
  \Drupal::state()->delete('simple_voting.allow_destructive_uninstall');

  $database = \Drupal::database();
  foreach (['simple_voting_vote', 'simple_voting_option'] as $table) {
    if ($database->schema()->tableExists($table)) {
      $database->schema()->dropTable($table);
    }
  }
}
